{
  // Use Flarum's tsconfig as a starting point
  "extends": "flarum-tsconfig",
  // This will match all .ts, .tsx, .d.ts, .js, .jsx files in your `src` folder
  // and also tells your Typescript server to read core's global typings for
  // access to `dayjs` and `$` in the global namespace.
  //
  // O segundo caminho de vendor (`../../../vendor`) cobre o layout de
  // workbench, com a extensão em `flarum/workbench/stickers/`.
  "include": [
    "src/**/*",
    "../vendor/flarum/core/js/dist-typings/@types/**/*",
    "../../../vendor/flarum/core/js/dist-typings/@types/**/*",
    "@types/**/*"
  ],
  "compilerOptions": {
    // This will output typings to `dist-typings`
    "declarationDir": "./dist-typings",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "paths": {
      "flarum/*": ["../vendor/flarum/core/js/dist-typings/*", "../../../vendor/flarum/core/js/dist-typings/*"]
    }
  }
}
